# eeti-nas Configuration Parameters
# Paths are relative to the script directory or absolute

# Database location (Keep on SSD)
DB_RELATIVE_PATH="../data/nas_metadata.db"

# Where your actual files live (External HDD)
MOUNT_POINT="/mnt/Drive1"

# Where to store the tiny UI previews (Keep on SSD)
THUMB_DIR="../data/thumbnails"

# Performance Settings
MAX_PARALLEL_THUMBS=4
THUMB_SIZE="300x300"
